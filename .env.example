# Required: Gemini API key used only by the Electron main process.
GEMINI_API_KEY=
# Optional alternative name for the Gemini API key.
GOOGLE_API_KEY=
# Optional Gemini Live model override.
ATLAS_MODEL=
# Optional Gemini Live voice override.
ATLAS_VOICE=
# Set to 1 to enable Google Search after billing is available.
ATLAS_GOOGLE_SEARCH=
# Context compression threshold in tokens (default: 8000).
ATLAS_CONTEXT_LIMIT=
# Fallback USD/TRY exchange rate for local cost estimates.
ATLAS_USD_TRY=
# Tool mode: direct, jev, or jev_pre.
ATLAS_TOOL_MODE=
# Required only for Jev tool-routing modes.
TYPESAFE_API_KEY=
# Tool-response watchdog delay in milliseconds; set to 0 to disable.
ATLAS_WATCHDOG_MS=
# Maximum Jev spend in USD (default: 10).
ATLAS_JEV_BUDGET_USD=
# Optional directory for settings and local usage ledgers.
ATLAS_USER_DATA=
